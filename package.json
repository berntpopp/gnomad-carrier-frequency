{
  "name": "gnomad-carrier-frequency",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter gnomad-cf-web dev",
    "build": "bun run --filter @gnomad-cf/core build && bun run --filter @gnomad-cf/cli build && bun run --filter gnomad-cf-web build",
    "build:cli": "bun run --filter @gnomad-cf/core build && bun run --filter @gnomad-cf/cli build",
    "preview": "bun run --filter gnomad-cf-web preview",
    "test": "vitest --passWithNoTests",
    "lint": "bun run --filter gnomad-cf-web lint",
    "typecheck": "bun run --filter @gnomad-cf/core build && tsc --build packages/cli && bun run --filter gnomad-cf-web typecheck",
    "lighthouse": "lhci autorun --config=lighthouserc.local.json",
    "docs:dev": "bun run --filter gnomad-cf-web docs:dev",
    "docs:build": "bun run --filter gnomad-cf-web docs:build",
    "docs:preview": "bun run --filter gnomad-cf-web docs:preview",
    "og:generate": "npx tsx scripts/generate-og-image.ts",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,vue}\" \"packages/core/src/**/*.ts\" \"packages/cli/src/**/*.ts\"",
    "format:fix": "prettier --write \"apps/web/src/**/*.{ts,vue}\" \"packages/core/src/**/*.ts\" \"packages/cli/src/**/*.ts\"",
    "ci": "bun run lint && bun run format:check && bun run typecheck && bun run build && bun run docs:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "tsdown": "0.20.3",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "flatted": ">=3.4.0",
    "defu": ">=6.1.7"
  }
}
